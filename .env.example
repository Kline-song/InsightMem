# Service authentication. Use an independent random value; never commit it.
MEMORY_API_KEY=replace-with-a-long-random-secret
ALLOW_UNAUTHENTICATED=false

# SQLite database and optional retrieval profile overrides.
MEMORY_DB_PATH=artifacts/memory.db
CODING_CONFIG_PATH=configs/coding/default.json

# Embeddings. `auto` selects DashScope for text-embedding-v4 and the local
# sentence-transformers backend for every other model name.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=
EMBEDDING_BACKEND=auto

# DashScope text-embedding-v4 (fill the key locally, never in the repository).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_CONCURRENCY=4
# Leave unset for the DashScope backend; the BGE instruction is rejected there.
# EMBEDDING_QUERY_PREFIX=
