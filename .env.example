OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_API_KEY=replace-with-a-long-random-secret
MEMORY_DB_PATH=artifacts/memory.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=
# auto selects DashScope for text-embedding-v4, otherwise the original local backend.
EMBEDDING_BACKEND=auto
# To use v4, set EMBEDDING_MODEL=text-embedding-v4 and fill these locally.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
# Leave unset for the model-specific default. Set to an empty string to disable.
# EMBEDDING_QUERY_PREFIX=
MEMORY_CHUNK_TOKENS=320
MEMORY_CHUNK_OVERLAP=40
MEMORY_RETRIEVAL_MODE=hybrid
MEMORY_RRF_K=60
MEMORY_LEXICAL_WEIGHT=0.5
MEMORY_CONTEXT_MESSAGES=0
MEMORY_OPTION_VIEW_WEIGHT=0
MEMORY_RERANKER_MODEL=
MEMORY_RERANKER_DEVICE=
MEMORY_RERANKER_BATCH_SIZE=32
MEMORY_RERANKER_MAX_LENGTH=512
MEMORY_RERANK_CANDIDATES=200
MEMORY_TEMPORAL_ENRICHMENT=false
MEMORY_RESULT_WINDOW=1
MEMORY_RESULT_WINDOW_SEED_K=20
ALLOW_UNAUTHENTICATED=false
