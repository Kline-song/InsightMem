# Alibaba Bailian text-embedding-v4 profile.
# Copy the values into the ignored .env and fill the key on the server.
# Never commit a real key.
EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# Accepted as a fallback when DASHSCOPE_API_KEY is empty.
# MEMORY_EMBED_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
# Parallel embedding requests inside one Add (1-16). 4 matches the reference
# AML adapter and keeps the largest observed Add under a practical latency.
EMBEDDING_CONCURRENCY=4
# Must stay unset: the BGE query instruction is rejected by the DashScope backend.
# EMBEDDING_QUERY_PREFIX=
